{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "title", "editorial"],
    "additionalProperties": false,
    "properties": {
      "_id": {"bsonType": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,63}$"},
      "title": {"bsonType": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
      "editorial": {
        "bsonType": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "credits": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "object",
              "required": ["name", "role"],
              "additionalProperties": false,
              "properties": {
                "name": {"bsonType": "string", "minLength": 1, "maxLength": 160},
                "role": {"bsonType": "string", "minLength": 1, "maxLength": 100}
              }
            }
          },
          "notes": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "object",
              "required": ["text", "source"],
              "additionalProperties": false,
              "properties": {
                "text": {"bsonType": "string", "minLength": 1, "maxLength": 1000},
                "source": {"bsonType": "string", "minLength": 1, "maxLength": 200}
              }
            }
          }
        }
      }
    }
  }
}
